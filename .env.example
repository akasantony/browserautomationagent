# Required: Your OpenAI API key
OPENAI_API_KEY=sk-...

# Optional: Override the default model (default: gpt-4o)
# MODEL_NAME=gpt-4o-mini

# Optional: Authentication credentials for websites that require login
AUTH_USERNAME=
AUTH_PASSWORD=

# Optional: Record-Then-Replay settings
# PATHS_DIR=~/.browseragent/paths   # Where recorded paths are stored
# REPLAY_ENABLED=true               # Set to false to always use LLM agent
# OPTIMIZE_PATHS=true               # Set to false to skip LLM path optimization

